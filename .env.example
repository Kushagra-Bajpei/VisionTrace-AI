# ==============================================================================
# VisionTrace AI — Environment Configuration Template
# Copy this file to .env and supply your local configuration.
# ==============================================================================

# ── Application Security ──────────────────────────────────────────────────────
# Secret key used for signing JWT access and media tokens
APP_SECRET_KEY=your_secure_random_secret_key_here
APP_ENV=development

# ── Database Connection ───────────────────────────────────────────────────────
# Production: PostgreSQL with psycopg3 driver
# Development: postgresql+psycopg://<username>:<password>@<host>:<port>/<dbname>
# Lightweight fallback: sqlite:///./visiontrace.db
DATABASE_URL=postgresql+psycopg://<db_user>:<db_password>@localhost:5432/<db_name>

# ── Message Broker & Cache ────────────────────────────────────────────────────
# Redis connection for background tasks and caching
REDIS_URL=redis://localhost:6379/0

# ── External AI APIs (Optional) ────────────────────────────────────────────────
# API keys for external generative AI integrations
GEMINI_API_KEY=
OPENAI_API_KEY=
