# Environment Configuration
# Copy this file to .env and fill in your values

# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
DEBUG=true

# ─────────────────────────────────────────────
# API Server
# ─────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:5173

# ─────────────────────────────────────────────
# Database (PostgreSQL)
# ─────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://visiontrace:visiontrace@localhost:5432/visiontrace_db

# ─────────────────────────────────────────────
# Redis & Celery Task Queue
# ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─────────────────────────────────────────────
# Video Processing & Frame Extraction
# ─────────────────────────────────────────────
FRAME_EXTRACTION_FPS=1.0
FRAMES_STORAGE_DIR=storage/frames

# ─────────────────────────────────────────────
# Storage Configuration
# ─────────────────────────────────────────────
STORAGE_PATH=storage
VIDEO_STORAGE_DIR=storage/videos
VIDEO_THUMBNAIL_DIR=storage/thumbnails
VIDEO_TEMP_DIR=storage/temp
MAX_UPLOAD_SIZE_MB=500

# ─────────────────────────────────────────────
# AI & Computer Vision Models (Phase 4B)
# ─────────────────────────────────────────────
YOLO_MODEL_NAME=yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.25
YOLO_TRACKER_CONFIG=bytetrack.yaml
MODELS_DIR=storage/models

# ─────────────────────────────────────────────
# AI APIs (add keys when implementing AI features)
# ─────────────────────────────────────────────
GEMINI_API_KEY=
OPENAI_API_KEY=

# ─────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
