# ==============================================================================
# VisionTrace AI — Unified Master Git Ignore Specification
# Single project-wide ignore rules covering Frontend, Backend, AI Models, & Storage
# ==============================================================================

# ── 1. Node.js & Frontend Build Outputs ─────────────────────────────────────────
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/
.pnpm-store/
frontend/.pnpm-store/
.oxlint_cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── 2. Python Backend, Bytecode & Virtual Environments ──────────────────────────
__pycache__/
backend/**/__pycache__/
backend/alembic/versions/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/
backend/env/

# ── 3. Secrets & Environment Configurations ────────────────────────────────────
.env
.env.local
.env.*.local
*.local
backend/.env
backend/.env.local
backend/.env.*.local
frontend/.env.local
frontend/.env.*.local

# ── 4. Relational Database & State Files ────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
visiontrace.db
backend/visiontrace.db
*.db-journal
*.db-wal
*.db-shm

# ── 5. CCTV Media, Keyframe & Evidentiary Storage ──────────────────────────────
# (Keep directory tree via .gitkeep but never commit binary media or video files)
storage/videos/*
!storage/videos/.gitkeep
storage/thumbnails/*
!storage/thumbnails/.gitkeep
storage/frames/*
!storage/frames/.gitkeep
storage/crops/*
!storage/crops/.gitkeep
storage/clips/*
!storage/clips/.gitkeep
storage/reports/*
!storage/reports/.gitkeep
storage/temp_chrome_profile/

# ── 6. Computer Vision & Deep Learning Weights ─────────────────────────────────
*.pt
*.pth
*.onnx
*.engine
*.bin
yolov8*.pt
.cache/
torch_cache/
open_clip_cache/

# ── 7. Testing, Coverage & QA Artifacts ────────────────────────────────────────
.pytest_cache/
backend/.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.hypothesis/

# ── 8. Operating System & Editor Metadata ──────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Tt]humbs.db

# IDEs & Editors
.idea/
*.swp
*.swo
*~
*.suo
*.ntvs*
*.njsproj
*.sln
*.sublime-workspace
*.sublime-project

# ── 9. Runtime Logs & Task Schedules ───────────────────────────────────────────
*.log
logs/
backend/logs/
celerybeat-schedule
celerybeat.pid
